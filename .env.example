# Client-side
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_APP_TITLE=Print Procurement Portal

# Server-side
# ==========================================================================
# Print Procurement Portal — environment template
#
#   cp .env.example .env
#
# This file is for LOCAL SECRETS and machine-specific overrides. Non-secret
# per-environment defaults are committed in src/config/env/.env.<APP_ENV>.
#
# Load order (first value wins):
#   process env  >  .env.local  >  .env  >  src/config/env/.env.<APP_ENV>
#
# Never commit .env. Deployed environments get their secrets from the secret
# manager; the config validator refuses to boot on a leftover placeholder.
# ==========================================================================

# --- Application -----------------------------------------------------------
NODE_ENV=development
APP_ENV=development               # development | staging | production
APP_NAME=ticketit-portal
API_PREFIX=api
API_VERSION=1
SHUTDOWN_TIMEOUT_MS=15000
# Public address of the Next.js frontend. Every emailed link (invitation,
# password reset) is built against it, so it must be reachable by the
# *recipient*, not by this API.
PORTAL_BASE_URL=http://localhost:3001

# --- Database (PostgreSQL) -------------------------------------------------
# SQL Server, the same engine as production and as the legacy Ticket-IT
# database. trustServerCertificate is for the local container's
# self-signed certificate only — never set it against a real server.
DATABASE_URL=sqlserver://localhost:51433;database=ticketit;user=ticketit;password=Ticketit_Local_2026!;encrypt=true;trustServerCertificate=true

# Prisma rebuilds the schema from scratch in a shadow database to detect
# drift. SQL Server will not let it create one unless the login holds
# dbcreator, which the application login must never have — so the database
# is created up front (see docker/docker-compose.yml) and named here.
SHADOW_DATABASE_URL=sqlserver://localhost:51433;database=ticketit_shadow;user=ticketit;password=Ticketit_Local_2026!;encrypt=true;trustServerCertificate=true
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOG_QUERIES=false

# --- Ticket-IT API ---------------------------------------------------------
# The upstream .NET service. It owns the credential and the profile of every
# user the portal did not invite itself: POST /api/v1/Account/login verifies the
# password and GET /api/v1/User/GetCurrentLoginUserDetails returns the profile
# that is replicated locally. No password is stored here for those users.
# Origin only — no trailing path or slash.
TICKETIT_API_BASE_URL=https://HOST
# How long a login waits for it before answering 503. A slow upstream must not
# hold the request open indefinitely.
TICKETIT_API_TIMEOUT_MS=15000
# Set false to allow only portal-native (invited and seeded) logins. Use it for
# a checkout with no reachable API, so attempts fail fast rather than time out.
TICKETIT_AUTH_ENABLED=true

# --- Redis (cache + BullMQ) ------------------------------------------------
REDIS_URL=redis://localhost:6379
# How long a reporting aggregate stays cached. Zero disables the cache
# entirely, which is what the test suite runs with — nothing transactional is
# ever cached, so switching it off changes speed and not answers.
CACHE_TTL_SECONDS=60

REDIS_KEY_PREFIX=ticketit
# Namespaces every BullMQ key, separately from the cache prefix above: a cache
# prefix is safe to change at any time, a queue prefix is not — changing it
# strands whatever is still sitting on the old one.
QUEUE_PREFIX=ticketit

# --- Background worker (npm run worker) ------------------------------------
# Concurrency per queue. Imports are serial on purpose: two runs of the same
# file in parallel would have the second report as skipped what the first had
# just created. Renders stay low because image decoding is memory-hungry.
WORKER_EMAIL_CONCURRENCY=5
WORKER_IMPORT_CONCURRENCY=1
WORKER_RENDER_CONCURRENCY=2
WORKER_SHIPPING_CONCURRENCY=2     # NZ Post label/tracking jobs; each is an NZ Post call

# --- Object storage (S3 / MinIO locally) -----------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ticketit-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true          # true for MinIO, false for real AWS S3
S3_PUBLIC_BASE_URL=http://localhost:9000/ticketit-assets
S3_PRESIGN_EXPIRY_SECONDS=900

# --- Document library (DAM) ------------------------------------------------
# The library is Ticket-IT's ImageManagement API, called with the signed-in
# user's own Ticket-IT token — kept server-side, encrypted, in Redis from the
# moment they sign in — because Ticket-IT decides whose images to return from
# that token alone. So it has no endpoint or credentials of its own: it needs
# TICKETIT_API_BASE_URL and REDIS_URL, and only Ticket-IT users can open it
# (invited and seeded users have no Ticket-IT token).
#
# With DAM_ENABLED=false every /api/v1/dam route answers 503.
#
# Wired: folders, folder contents, images, search, file notes (DAM_VIEW), and
# upload (DAM_UPLOAD). Folder management, note editing and the share cart exist
# upstream and are not wired.
DAM_ENABLED=false

# Which multipart field ImageManagement/UploadImage binds its files from. The
# OpenAPI document declares both `imageFiles` and `imageFile`, marks neither
# required and types no response, so which one the controller actually reads
# cannot be told from outside. If an upload answers 201 and the folder stays
# empty, switch this to imageFile.
#   scripts/check-ticketit-dam.mjs --upload <file> settles it against a real account.
DAM_UPLOAD_FILE_FIELD=imageFiles

# How long one upload may take. Separate from TICKETIT_API_TIMEOUT_MS, which is
# sized for small JSON calls and would cut a 60MB push off halfway.
DAM_UPLOAD_TIMEOUT_MS=120000

# Biggest single file the library will take, and the biggest the portal will
# copy back out, in MB. A memory setting: both paths buffer the whole file in
# the Node process, so raise these against the container's actual limit.
# 100MB covers a packaged InDesign job.
DAM_UPLOAD_MAX_FILE_MB=100
DAM_COPY_MAX_MB=100

# The portal's own Ticket-IT account, for operator-owned artwork only.
#
# Product images, and templates in the operator's own library, are copied out of
# the library into S3 when they are attached, and that copy runs on this
# credential rather than the admin's. Two reasons: those files belong to the
# operator rather than to any tenant, and an admin who signed in as a
# portal-native user has no Ticket-IT token at all and could otherwise never
# attach an image.
#
# A CUSTOMER-owned template is read with that customer's own token instead --
# their file is in their library, and using this credential there would copy the
# operator's file of the same name into their template. See
# src/server/dam/dam-service-account.ts.
#
# Every /api/v1/dam route still runs on the caller's own token -- browsing on a
# service account would show one tenant another's library. See
# src/server/dam/dam-service-account.ts.
#
# Without these, POST /templates/:id/assets and /catalog/products/:id/assets
# answer 503.
DAM_SERVICE_LOGIN=
DAM_SERVICE_PASSWORD=

# --- NZ Post shipping (SOW §7) ----------------------------------------------
# mock:     every NZ Post call answered by a built-in fake; labels say MOCK.
# live:     calls NZ Post. Each capability (address, rates, collection, label,
#           pickup, tracking) goes live only once what it needs is set —
#           GET /api/v1/shipping/status lists what is missing.
# disabled: shipping switched off; dispatch works as it did before.
# Unset, it is mock everywhere except APP_ENV=production, where it is disabled.
NZPOST_MODE=mock
# From the NZ Post developer portal application (Client Credentials grant).
# Secrets: never commit real values.
NZPOST_CLIENT_ID=
NZPOST_CLIENT_SECRET=
NZPOST_OAUTH_URL=https://oauth.nzpost.co.nz/as/token.oauth2
# Origin of the NZ Post instance. NZ Post documents two:
#   https://api.uat.nzpost.co.nz  integration testing (ask api@nzpost.co.nz for access)
#   https://api.nzpost.co.nz      production, only after NZ Post's go-live checklist
# No default in code, so live mode can never reach production by accident.
NZPOST_API_BASE_URL=https://api.uat.nzpost.co.nz
# Base paths below the origin; empty means these defaults. The first four are
# from the downloaded specs, the last two from NZ Post's documentation pages.
NZPOST_PARCELADDRESS_PATH=/parceladdress/2.0
NZPOST_SHIPPINGOPTIONS_PATH=/shippingoptions/2.0
NZPOST_PARCELLABEL_PATH=/parcellabel/v3
NZPOST_COLLECTIONADDRESS_PATH=/collectionaddress/v1
NZPOST_PARCELPICKUP_PATH=/parcelpickup/v3
NZPOST_PARCELTRACK_PATH=/parceltrack/3.0
NZPOST_TIMEOUT_MS=15000
NZPOST_ACCOUNT_NUMBER=
NZPOST_SITE_CODE=
NZPOST_USER_NAME=
# Ship-from: the one warehouse labels and pickups use (decision D3).
NZPOST_SENDER_NAME=
NZPOST_SENDER_COMPANY=
NZPOST_SENDER_PHONE=
NZPOST_SENDER_EMAIL=
NZPOST_PICKUP_BUILDING=
NZPOST_PICKUP_UNIT_TYPE=
NZPOST_PICKUP_UNIT_VALUE=
NZPOST_PICKUP_FLOOR=
NZPOST_PICKUP_STREET_NUMBER=
NZPOST_PICKUP_STREET=
NZPOST_PICKUP_SUBURB=
NZPOST_PICKUP_CITY=
NZPOST_PICKUP_POSTCODE=
NZPOST_PICKUP_INSTRUCTIONS=
# Used when neither the buyer nor staff chose a service.
NZPOST_DEFAULT_SERVICE_CODE=CPOLP
# The box a checkout quote assumes, LxWxH in cm. Labels use staff measurements.
NZPOST_DEFAULT_PARCEL_CM=30x20x10
# Offered at checkout when live rates are unavailable. Empty means no fallback.
NZPOST_FALLBACK_RATE_INCL_GST=
NZPOST_FALLBACK_SERVICE_CODE=CPOLP
NZPOST_FALLBACK_SERVICE_NAME=Standard courier (flat rate)
NZPOST_TRACKING_POLL_MINUTES=180
# Labels unscanned this many days after labelling are flagged for void.
NZPOST_UNSCANNED_LABEL_DAYS=7

# --- Maintenance -------------------------------------------------------------
# Delivery addresses typed at checkout (SOW F-18) that no basket or order uses
# any more are removed by the worker's daily job once they are this many days old.
ONE_OFF_ADDRESS_RETENTION_DAYS=30

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-local-access-secret-min-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-local-refresh-secret-min-32-characters-long
JWT_REFRESH_TTL=30d
PASSWORD_HASH_MEMORY_COST=19456
PASSWORD_HASH_TIME_COST=2
# How long a single-use link stays valid. An invitation is a week because an
# administrator sends it and a person answers it on their own schedule; a
# password reset is an hour because the user is waiting for it right now.
INVITATION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=60

# --- Security --------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
# Ten is right for production: this bucket exists to blunt credential stuffing,
# and a real person does not need an eleventh attempt in a minute. It is too
# tight for an environment that runs the verification suite, which signs in nine
# times per run across its three HTTP checks — raise it wherever `npm run verify`
# is expected to work, and leave it alone in production.
RATE_LIMIT_AUTH_MAX=10
TRUST_PROXY=false
WEBHOOK_HMAC_SECRET=change-me-local-webhook-hmac-secret-min-32-chars
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# --- Mail ------------------------------------------------------------------
MAIL_TRANSPORT=smtp               # smtp | sendgrid | postmark | console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM_ADDRESS=no-reply@ticketit.local
MAIL_FROM_NAME=Print Procurement Portal

# --- Workers ---------------------------------------------------------------
WORKER_CONCURRENCY=5
RENDER_CONCURRENCY=2
RENDER_JOB_TIMEOUT_MS=120000
RENDER_BROWSER_POOL_SIZE=2

# --- Observability ---------------------------------------------------------
LOG_LEVEL=debug                   # trace | debug | info | warn | error | fatal
LOG_PRETTY=true                   # false in every deployed environment
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Feature flags ---------------------------------------------------------
SWAGGER_ENABLED=true              # forced off in production
FEATURE_ROLE_SWITCHER=true        # demo-only role switcher; forced off in production
FEATURE_MOCK_INTEGRATIONS=true    # use mock PrintFlow/3PL/ERP adapters
