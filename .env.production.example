# Production configuration.
#
# Not a file to copy and fill in on a server: it is the list of what the
# environment has to supply, so it can be turned into whatever the deployment
# actually uses — App Service settings, a Kubernetes secret, a vault.
#
# Only three values have no default and will stop the process at startup if they
# are missing: DATABASE_URL, JWT_ACCESS_SECRET and JWT_REFRESH_SECRET. Everything
# else has a sensible default, which is a trap of its own — a default that is
# right for a laptop is rarely right for a server, so the ones that matter are
# marked below.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
# Read separately from NODE_ENV so staging can behave like production while
# still being recognisable in logs and error payloads.
APP_ENV=production
PORT=3000
# The commit or tag this image was built from. It is what /health reports, and
# it is the difference between "the bug is fixed" and "the fix is deployed".
GIT_SHA=

# --- Database --------------------------------------------------------------
#
# The application login: db_datareader, db_datawriter, EXECUTE on dbo and UPDATE
# on the order-number sequence. It must NOT be the migrator — see
# scripts/sql/provision-database.sql.
#
# encrypt=true and trustServerCertificate=FALSE. The local compose file sets
# trust to true because the container mints its own certificate; doing that
# against a real server accepts any certificate presented, which is the whole
# of what TLS was protecting.
DATABASE_URL=sqlserver://<host>:1433;database=ticketit;user=ticketit_app;password=<secret>;encrypt=true;trustServerCertificate=false

# Deliberately absent in production. Prisma uses a shadow database only for
# `migrate dev`, which must never run here — `migrate deploy` needs none.
# SHADOW_DATABASE_URL=

DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Ticket-IT API ---------------------------------------------------------
#
# Point this at the production service, not the QA one the local file uses.
# Every user who exists upstream is authenticated against it on every sign-in —
# it is on the critical path of those logins, not just their first one, and no
# password is stored here to fall back to. Size the timeout accordingly and
# watch `ticketit-api` on /health/dependencies.
TICKETIT_API_BASE_URL=https://<host>
TICKETIT_API_TIMEOUT_MS=15000
TICKETIT_AUTH_ENABLED=true

# --- Secrets ---------------------------------------------------------------
#
# At least 32 characters each, and different from one another: an access token
# and a refresh token must not be interchangeable. Generate with
# `openssl rand -base64 48`. Rotating either signs everyone out, which is the
# intended behaviour and worth planning for rather than discovering.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Public addresses ------------------------------------------------------
#
# PORTAL_BASE_URL is the base of every link the portal emails — an invitation
# that points at localhost is an invitation nobody can accept.
PORTAL_BASE_URL=https://<portal-host>
# Exact origins, comma separated. Not a wildcard: the API answers with
# credentials, and a wildcard with credentials is what the browser refuses.
CORS_ORIGINS=https://<portal-host>

# --- Redis -----------------------------------------------------------------
#
# Required for the worker. Without it the queues do not exist: mail falls back
# to sending inline with no retry, bulk import refuses outright rather than
# accepting a job nothing will drain, and image derivatives stay PENDING until a
# sweep finds them.
REDIS_URL=rediss://<host>:6380
REDIS_KEY_PREFIX=ticketit:
QUEUE_PREFIX=ticketit
CACHE_TTL_SECONDS=60

WORKER_EMAIL_CONCURRENCY=5
WORKER_IMPORT_CONCURRENCY=1
WORKER_RENDER_CONCURRENCY=2

# --- Object storage --------------------------------------------------------
#
# Artwork, product images and generated invoice documents. Any S3-compatible
# endpoint; leave S3_ENDPOINT unset for AWS itself.
S3_ENDPOINT=
S3_REGION=<region>
S3_BUCKET=<bucket>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# false for AWS S3, true for MinIO and most self-hosted gateways.
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=
S3_PRESIGN_EXPIRY_SECONDS=900

# --- Mail ------------------------------------------------------------------
#
# Undecided at the time of writing — this may become an Azure-hosted sender
# rather than SMTP. Until then these are the SMTP settings the worker uses.
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Print Procurement Portal

# --- Rate limiting ---------------------------------------------------------
#
# Ten login attempts per window. Deliberately not raised here: the verification
# suite needs more and says so, but production is where this limit is doing the
# job it exists for.
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10
