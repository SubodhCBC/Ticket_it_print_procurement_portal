{
  "name": "printprocurementportal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-onnx-runtime.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-onnx-runtime.mjs",
    "build": "next build",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker/index.ts",
    "verify": "node --env-file-if-exists=.env scripts/verify-all.mjs",
    "verify:isolation": "node --env-file-if-exists=.env scripts/verify-tenant-isolation.mjs",
    "verify:utc": "node --env-file-if-exists=.env scripts/verify-utc-timestamps.mjs",
    "verify:templates": "node --env-file-if-exists=.env scripts/verify-template-ownership.mjs",
    "verify:schema": "node --env-file-if-exists=.env scripts/verify-schema-guarantees.mjs",
    "bench:search": "node --env-file-if-exists=.env scripts/benchmark-catalogue-search.mjs",
    "check:ticketit-auth": "node --env-file-if-exists=.env scripts/check-ticketit-auth.mjs",
    "check:ticketit-dam": "node --env-file-if-exists=.env scripts/check-ticketit-dam.mjs",
    "worker:dev": "node --env-file-if-exists=.env --import tsx --watch src/worker/index.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write .",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed/index.ts",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "data:backup": "node scripts/data-transfer.mjs backup",
    "data:restore": "node scripts/data-transfer.mjs restore",
    "typecheck": "tsc --noEmit",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@node-rs/argon2": "^2.2.0",
    "@prisma/client": "^6.2.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-query": "^5.102.8",
    "@types/fabric": "^5.3.0",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "exceljs": "^4.4.0",
    "fabric": "^5.3.0",
    "framer-motion": "^13.1.1",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.38.0",
    "next": "^16.3.4",
    "nodemailer": "^9.1.1",
    "onnxruntime-web": "^1.29.0",
    "pdfkit": "^0.20.2",
    "prisma": "^6.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.4",
    "react-redux": "^9.3.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html}": "prettier --write"
  }
}
